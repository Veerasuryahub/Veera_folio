rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      // Public visitors may submit a contact message, but cannot read the inbox.
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'message', 'timestamp', 'read'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'message', 'timestamp', 'read'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.timestamp == request.time
        && request.resource.data.read == false;

      // Only the verified portfolio owner account can read contact messages.
      allow read: if request.auth != null
        && request.auth.token.email == 'veerasurya39@gmail.com'
        && request.auth.token.email_verified == true;

      // Messages are immutable from the client.
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
